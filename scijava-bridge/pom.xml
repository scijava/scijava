<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.scijava</groupId>
		<artifactId>pom-scijava</artifactId>
		<version>44.0.0</version>
		<relativePath />
	</parent>

	<artifactId>scijava-bridge</artifactId>
	<!--
	NB: the major version tracks the incarnation, per the incubator README.
	The 1.x.y of the other components is a legacy of the first monoversioned
	release, not the intended scheme.
	-->
	<version>3.0.0-SNAPSHOT</version>

	<name>SciJava Bridge</name>
	<description>Presenting SciJava Common's modules as SciJava3 commands.</description>
	<url>https://github.com/scijava/scijava</url>
	<inceptionYear>2026</inceptionYear>
	<organization>
		<name>SciJava</name>
		<url>https://scijava.org/</url>
	</organization>
	<licenses>
		<license>
			<name>Simplified BSD License</name>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>ctrueden</id>
			<name>Curtis Rueden</name>
			<roles>
				<role>founder</role>
				<role>lead</role>
				<role>reviewer</role>
				<role>support</role>
				<role>maintainer</role>
			</roles>
		</developer>
		<developer>
			<id>gselzer</id>
			<name>Gabriel Selzer</name>
			<roles>
				<role>founder</role>
				<role>debugger</role>
				<role>reviewer</role>
				<role>support</role>
			</roles>
		</developer>
	</developers>
	<contributors>
		<contributor>
			<name>Johannes Schindelin</name>
			<properties><id>dscho</id></properties>
		</contributor>
	</contributors>

	<mailingLists>
		<mailingList>
			<name>Image.sc Forum</name>
			<archive>https://forum.image.sc/tag/scijava</archive>
		</mailingList>
	</mailingLists>

	<scm>
		<connection>scm:git:https://github.com/scijava/scijava</connection>
		<developerConnection>scm:git:git@github.com:scijava/scijava</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/scijava/scijava</url>
	</scm>
	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/scijava/scijava/issues</url>
	</issueManagement>
	<ciManagement>
		<system>GitHub Actions</system>
		<url>https://github.com/scijava/scijava/actions</url>
	</ciManagement>

	<properties>
		<package-name>org.scijava.bridge</package-name>

		<license.licenseName>bsd_2</license.licenseName>
		<license.copyrightOwners>SciJava developers.</license.copyrightOwners>

		<!-- Note: These versions must match across all component POMs! -->
		<scijava-command3.version>3.0.0-SNAPSHOT</scijava-command3.version>
		<scijava-common3.version>1.0.1-SNAPSHOT</scijava-common3.version>
		<scijava-harvest.version>1.0.0-SNAPSHOT</scijava-harvest.version>
		<scijava-ui3.version>3.0.0-SNAPSHOT</scijava-ui3.version>
		<scijava-convert3.version>3.0.0-SNAPSHOT</scijava-convert3.version>
		<scijava-execute.version>1.0.0-SNAPSHOT</scijava-execute.version>
		<scijava-priority.version>1.0.1-SNAPSHOT</scijava-priority.version>
		<scijava-struct.version>1.0.1-SNAPSHOT</scijava-struct.version>
	</properties>

	<dependencies>
		<!--
		NB: this is the only component that depends on SciJava Common, and the
		dependency goes one way and stays here. Nothing in SciJava Common knows
		this exists, and nothing else in SciJava3 sees it.
		-->
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-common</artifactId>
		</dependency>
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-command3</artifactId>
			<version>${scijava-command3.version}</version>
		</dependency>
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-common3</artifactId>
			<version>${scijava-common3.version}</version>
		</dependency>
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-convert3</artifactId>
			<version>${scijava-convert3.version}</version>
		</dependency>
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-execute</artifactId>
			<version>${scijava-execute.version}</version>
		</dependency>
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-priority</artifactId>
			<version>${scijava-priority.version}</version>
		</dependency>
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-struct</artifactId>
			<version>${scijava-struct.version}</version>
		</dependency>

		<!-- Test scope dependencies -->
		<!--
		NB: the dialog *model*, which is where this component's claim ends: a
		legacy command described correctly enough for any toolkit to render it.
		That a correct model becomes correct widgets is what the toolkit
		bindings' shared conformance suite already establishes, three times
		over, so the bridge has no business importing a toolkit even here.
		-->
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-harvest</artifactId>
			<version>${scijava-harvest.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-ui3</artifactId>
			<version>${scijava-ui3.version}</version>
			<scope>test</scope>
		</dependency>
		<!--
		NB: a real engine, so that the tests exercise a language rather than a
		stand-in. Any JSR-223 engine on the classpath is discovered the same
		way; Groovy is simply the one Fiji users meet first.
		-->
		<dependency>
			<groupId>org.apache.groovy</groupId>
			<artifactId>groovy</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.groovy</groupId>
			<artifactId>groovy-jsr223</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
			NB: SciJava Common's own annotation processor, so that the legacy
			command in the tests is indexed by the old world's tooling, which
			is the only honest way to test a bridge to it.
			-->
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.scijava</groupId>
							<artifactId>scijava-common</artifactId>
							<version>${scijava-common.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>enforce-package-rules</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<phase>test</phase>
						<configuration>
							<rules>
								<NoPackageCyclesRule implementation="org.scijava.maven.plugin.enforcer.NoPackageCyclesRule" />
								<NoSubpackageDependenceRule implementation="org.scijava.maven.plugin.enforcer.NoSubpackageDependenceRule" />
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-javadoc-plugin</artifactId>
				<configuration>
					<links>
						<link>https://javadoc.scijava.org/Java11/</link>
					</links>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
