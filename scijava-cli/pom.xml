<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.scijava</groupId>
		<artifactId>pom-scijava</artifactId>
		<version>44.0.0</version>
		<relativePath />
	</parent>

	<artifactId>scijava-cli</artifactId>
	<!--
	NB: the major version tracks the incarnation, per the incubator README.
	The 1.x.y of the other components is a legacy of the first monoversioned
	release, not the intended scheme.
	-->
	<version>1.0.0-SNAPSHOT</version>

	<name>SciJava CLI</name>
	<description>Running commands and scripts from a command line.</description>
	<url>https://github.com/scijava/scijava</url>
	<inceptionYear>2026</inceptionYear>
	<organization>
		<name>SciJava</name>
		<url>https://scijava.org/</url>
	</organization>
	<licenses>
		<license>
			<name>Simplified BSD License</name>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>ctrueden</id>
			<name>Curtis Rueden</name>
			<roles>
				<role>founder</role>
				<role>lead</role>
				<role>reviewer</role>
				<role>support</role>
				<role>maintainer</role>
			</roles>
		</developer>
		<developer>
			<id>gselzer</id>
			<name>Gabriel Selzer</name>
			<roles>
				<role>founder</role>
				<role>debugger</role>
				<role>reviewer</role>
				<role>support</role>
			</roles>
		</developer>
	</developers>
	<contributors>
		<contributor>
			<name>Johannes Schindelin</name>
			<properties><id>dscho</id></properties>
		</contributor>
	</contributors>

	<mailingLists>
		<mailingList>
			<name>Image.sc Forum</name>
			<archive>https://forum.image.sc/tag/scijava</archive>
		</mailingList>
	</mailingLists>

	<scm>
		<connection>scm:git:https://github.com/scijava/scijava</connection>
		<developerConnection>scm:git:git@github.com:scijava/scijava</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/scijava/scijava</url>
	</scm>
	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/scijava/scijava/issues</url>
	</issueManagement>
	<ciManagement>
		<system>GitHub Actions</system>
		<url>https://github.com/scijava/scijava/actions</url>
	</ciManagement>

	<properties>
		<package-name>org.scijava.cli</package-name>

		<license.licenseName>bsd_2</license.licenseName>
		<license.copyrightOwners>SciJava developers.</license.copyrightOwners>

		<!-- Note: These versions must match across all component POMs! -->
		<scijava-command3.version>3.0.0-SNAPSHOT</scijava-command3.version>
		<scijava-common3.version>1.0.1-SNAPSHOT</scijava-common3.version>
		<scijava-context.version>1.0.0-SNAPSHOT</scijava-context.version>
		<scijava-discovery.version>1.0.1-SNAPSHOT</scijava-discovery.version>
		<scijava-index.version>1.0.0-SNAPSHOT</scijava-index.version>
		<scijava-script3.version>3.0.0-SNAPSHOT</scijava-script3.version>
		<scijava-convert3.version>3.0.0-SNAPSHOT</scijava-convert3.version>
		<scijava-execute.version>1.0.0-SNAPSHOT</scijava-execute.version>
		<scijava-priority.version>1.0.1-SNAPSHOT</scijava-priority.version>
		<scijava-struct.version>1.0.1-SNAPSHOT</scijava-struct.version>
	</properties>

	<dependencies>
		<!--
		NB: commands come from wherever the caller found them - the annotation
		index, a scripts directory, the legacy bridge - so this component
		depends on the command layer and the script layer, and on no source of
		commands in particular.
		-->
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-command3</artifactId>
			<version>${scijava-command3.version}</version>
		</dependency>
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-context</artifactId>
			<version>${scijava-context.version}</version>
		</dependency>
		<!--
		NB: pinned although no import here names it. Discovering commands goes
		through it, and an unpinned SciJava dependency resolves whatever is
		released rather than what is in this reactor.
		-->
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-discovery</artifactId>
			<version>${scijava-discovery.version}</version>
		</dependency>
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-index</artifactId>
			<version>${scijava-index.version}</version>
		</dependency>
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-script3</artifactId>
			<version>${scijava-script3.version}</version>
		</dependency>
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-common3</artifactId>
			<version>${scijava-common3.version}</version>
		</dependency>
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-convert3</artifactId>
			<version>${scijava-convert3.version}</version>
		</dependency>
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-execute</artifactId>
			<version>${scijava-execute.version}</version>
		</dependency>
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-priority</artifactId>
			<version>${scijava-priority.version}</version>
		</dependency>
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-struct</artifactId>
			<version>${scijava-struct.version}</version>
		</dependency>

		<!-- Test scope dependencies -->
		<!--
		NB: a real engine, so that the tests exercise a language rather than a
		stand-in. Any JSR-223 engine on the classpath is discovered the same
		way; Groovy is simply the one Fiji users meet first.
		-->
		<dependency>
			<groupId>org.apache.groovy</groupId>
			<artifactId>groovy</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.groovy</groupId>
			<artifactId>groovy-jsr223</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- NB: the annotation index, for the test commands. -->
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.scijava</groupId>
							<artifactId>scijava-index</artifactId>
							<version>${scijava-index.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>enforce-package-rules</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<phase>test</phase>
						<configuration>
							<rules>
								<NoPackageCyclesRule implementation="org.scijava.maven.plugin.enforcer.NoPackageCyclesRule" />
								<NoSubpackageDependenceRule implementation="org.scijava.maven.plugin.enforcer.NoSubpackageDependenceRule" />
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-javadoc-plugin</artifactId>
				<configuration>
					<links>
						<link>https://javadoc.scijava.org/Java11/</link>
					</links>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
